import pandas as pd
import requests
from bs4 import BeautifulSoup

# Исследуем данный сайт с помощью Requests
url = "http://quotes.toscrape.com/"
html = requests.get(url)

# Проверяем, если ответ был позитивным - (200 OK)
if html.status_code == 200:
    # Создаем объект BeautifulSoup для того, чтобы парсить HTML контент страницы.
    soup = BeautifulSoup(html.text, "html.parser")

    # Готовим 3 пустых массива: quotes, authors, and tags
    quotes = []
    authors = []
    tags = []

    # Создаем цикл от 1 до 10, который будет исследовать каждую страницу на сайте
    root = "http://quotes.toscrape.com/page/"
    for pages in range(1, 10):
        html = requests.get(root + str(pages))
        soup = BeautifulSoup(html.text)

        # Добавляем полученную инфу к массивам
        for i in soup.findAll("div", {"class": "quote"}):
            quotes.append((i.find("span", {"class": "text"})).text)

        for j in soup.findAll("div", {"class": "quote"}):
            authors.append((j.find("small", {"class": "author"})).text)

        for k in soup.findAll("div", {"class": "tags"}):
            tags.append((k.find("meta"))["content"])

    # Создаем pandas dataframe
    df = pd.DataFrame({"Quotes": quotes, "Authors": authors, "Tags": tags})

    # Печатаем dataframe
    print(df.head())
else:
    print("Failed to retrieve page")
